NODE_ENV="development"

# Disable @Cron jobs locally so they don't deadlock with the functional
# suite's database reset. Leave unset (or "true") in production.
SCHEDULER_ENABLED="false"

DATABASE_URL="postgres://user:pass@database:5432/app"

JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
MHcCAQEEIOh8rwROiIaqfAxJs0FPOSshQuj9RRA1oVnOBQJ7kxzfoAoGCCqGSM49
AwEHoUQDQgAEp4j7y5/vzxAOfvZFfgyeGwDrPIKUsR1EALULKBxKlMm/585yv6On
kdHYGuvHRmX4UL5GXQV4YK6kxOzfzwPQqQ==
-----END EC PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEp4j7y5/vzxAOfvZFfgyeGwDrPIKU
sR1EALULKBxKlMm/585yv6OnkdHYGuvHRmX4UL5GXQV4YK6kxOzfzwPQqQ==
-----END PUBLIC KEY-----"

ADSB_API_HOST="http://adsb-mock:1080"
ADSB_API_TOKEN="very-secret-token"

SKYLINK_API_HOST="http://skylink-mock:1080"
SKYLINK_API_TOKEN="very-secret-token"

SIMBRIEF_API_HOST="http://simbrief-mock:1080"

WEATHER_API_HOST="http://weather-mock:1080"

SAY_INTENTIONS_API_HOST="http://sayintentions-mock:1080"

DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/<server-id>/<auth-key>"

# Transactional email. Outside NODE_ENV=production nothing is sent — the test
# client writes each message to test-data/mail/ — so the placeholders below are
# enough for local development.
MAILGUN_API_HOST="https://api.mailgun.net"
MAILGUN_DOMAIN="mg.example.com"
MAILGUN_API_KEY="very-secret-token"
MAIL_FROM_ADDRESS="Flight Tracker <no-reply@mg.example.com>"

# Base URL of the frontend, used to build links sent by email.
FRONTEND_BASE_URL="http://localhost:5173"

# ID of operations user to auto-approve delays
AUTO_APPROVE_OPERATOR_ID="721ab705-8608-4386-86b4-2f391a3655a7"

# Google Sign-In. GOOGLE_CLIENT_ID must match the OAuth 2.0 Client ID that
# issues ID tokens to the frontend. GOOGLE_JWKS_URI points at the google-mock
# container locally; leave it unset in production to use Google directly.
GOOGLE_CLIENT_ID="123456789012-devmockclientid.apps.googleusercontent.com"
GOOGLE_JWKS_URI="http://google-mock:1080/oauth2/v3/certs"
